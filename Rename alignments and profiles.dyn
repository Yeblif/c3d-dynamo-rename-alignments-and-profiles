          "Name": "duplicate_unique_list...",
          "Description": "duplicate_unique_list_empty",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6cc9794ad5c14209bb52b26e2aaa3614",
          "Name": "string_seperators",
          "Description": "string_seperators",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "e1799222ae144bec9fcedbd7c7ae248e",
          "Name": "both_lists_valid",
          "Description": "both_lists_valid = count == 2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c56bb89a3c584f8a9950cda5d93b1b0f",
          "Name": "duplicate_list_empty",
          "Description": "duplicate_list_empty = (DesignScript.Builtin.Get.ValueAtIndex(duplicate_unique_list_empty, 0)) == true",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e118edd569eb4365995781dc446793aa",
          "Name": "conditional",
          "Description": "(both_lists_valid == true ? string_seperators : (duplicate_list_empty == true ? DesignScript.Builtin.Get.ValueAtIndex(string_seperators, 1) : DesignScript.Builtin.Get.ValueAtIndex(string_seperators, 0)))",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "//bool conditions\nboth_lists_valid = count == 2;\nduplicate_list_empty = duplicate_unique_list_empty[0] == true;\n\n//when unique AND/OR duplicate names are present\nboth_lists_valid == true ?\nstring_seperators:duplicate_list_empty == true?string_seperators[1]:string_seperators[0];"
    },
