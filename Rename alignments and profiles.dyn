    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "duplicate_unique_list_empty = IN[0]\r\nrename_action_string = IN[1]\r\nname_concat_string = IN[2]\r\n\r\n# action string\r\naction_string = \"Selected action: \\n\" + rename_action_string\r\n\r\n# conditianally add dummy data to name_concat_string to preserve indices\r\nname_concat_string = (\r\n    [\"temp\"] + name_concat_string \r\n    if duplicate_unique_list_empty[0] \r\n    else name_concat_string\r\n)\r\nname_concat_string = name_concat_string + [\"temp\"]\r\n\r\n# message if any lists are empty\r\nany_if_empty = \"none\"\r\n\r\n# not changed list\r\nnot_changed_data = (\r\n    any_if_empty \r\n    if duplicate_unique_list_empty[0] \r\n    else str(name_concat_string[0])\r\n)\r\n\r\nnot_changed_list = \"Not changed: \\n\" + not_changed_data\r\n\r\n# changed list\r\nchanged_data = (\r\n    any_if_empty \r\n    if duplicate_unique_list_empty[1] \r\n    else str(name_concat_string[1])\r\n)\r\nchanged_list = \"Changed: \\n\" + changed_data\r\n\r\n# output message\r\nOUT = action_string + \"\\n\\n\" + not_changed_list + \"\\n\\n\" + changed_list",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e97af27c755b4530ab35429517a620a4",
      "NodeType": "PythonScriptNode",
